<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>JobDetailController</servlet-name>
        <servlet-class>controllers.JobDetailController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>JobListingController</servlet-name>
        <servlet-class>controllers.JobListingController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>controllers.LogoutController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ResetPasswordController</servlet-name>
        <servlet-class>controllers.ResetPasswordController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CVListController</servlet-name>
        <servlet-class>controllers.CVListController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CVUpdateController</servlet-name>
        <servlet-class>controllers.CVUpdateController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CVCreateController</servlet-name>
        <servlet-class>controllers.CVCreateController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>controllers.HomeController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>NotificationController</servlet-name>
        <servlet-class>controllers.NotificationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JobDetailController</servlet-name>
        <url-pattern>/job-detail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>JobListingController</servlet-name>
        <url-pattern>/job-listing</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ResetPasswordController</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CVListController</servlet-name>
        <url-pattern>/list_cv</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CVUpdateController</servlet-name>
        <url-pattern>/update_cv</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CVCreateController</servlet-name>
        <url-pattern>/create_cv</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationController</servlet-name>
        <url-pattern>/notification</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
</web-app>
